# Copy this file to .env and fill in your values

# Optional. Leave empty to have Synapse generate one and store it in data/.jwt_secret.
# To set your own: openssl rand -base64 48
JWT_SECRET=

# Set to true to allow public sign-up. By default only the first (admin) account can
# register; the admin adds everyone else from Settings → Admin.
ALLOW_REGISTRATION=false

# Only needed if another site calls the API from the browser. Same-origin use needs nothing.
# CORS_ORIGIN=https://synapse.yourdomain.com
