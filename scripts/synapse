#!/usr/bin/env bash
# The `synapse` command — everyday management of a Synapse install.
# Installed to /usr/local/bin/synapse by install.sh. Run `synapse help` for commands.
#
# Everything goes through `docker compose` in the install folder, so it works however the
# notes are stored (a folder, a Docker volume or a network share) and with installs that
# were set up by hand.
set -euo pipefail

SYNAPSE_DIR="${SYNAPSE_DIR:-/opt/synapse}"   # set by the installer

if [ -t 1 ]; then B=$'\e[1m'; D=$'\e[2m'; R=$'\e[0m'; RED=$'\e[31m'; GRN=$'\e[32m'; YEL=$'\e[33m'
else B=""; D=""; R=""; RED=""; GRN=""; YEL=""; fi
ok()   { printf '%s✓%s %s\n' "$GRN" "$R" "$*"; }
warn() { printf '%s!%s %s\n' "$YEL" "$R" "$*"; }
die()  { printf '%s✗ %s%s\n' "$RED" "$*" "$R" >&2; exit 1; }
confirm() { local a; printf '%s %s[y/N]%s ' "$1" "$D" "$R"; IFS= read -r a </dev/tty || a=""; [[ "$a" =~ ^[Yy] ]]; }

usage() {
  cat <<EOF
${B}synapse${R} — manage your Synapse server  ${D}($SYNAPSE_DIR)${R}

  ${B}status${R}                      Is it running, where, and where are the notes?
  ${B}update${R}                      Download and start the latest version
  ${B}restart${R} | ${B}stop${R} | ${B}start${R}
  ${B}logs${R} [caddy]                Show recent logs (add -f to follow)

  ${B}backup${R} [folder]             Save all notes, uploads and settings to a .tar.gz
  ${B}restore${R} <file>              Restore from a backup (a safety backup is made first)
  ${B}backups-to${R} <folder>         Save the automatic backups there (e.g. your NAS), or "default"

  ${B}setup-code${R}                  Show the code for creating the admin account
  ${B}users${R}                       List accounts
  ${B}reset-password${R} <user>       Give someone a new temporary password
  ${B}reset-mfa${R} <user>            Turn off someone's two-step verification (lost phone)
  ${B}make-admin${R} <user>           Make an account an admin

  ${B}port${R} <number>               Move Synapse to another port (checks it's free)
  ${B}trust${R}                       HTTPS-by-IP: show the "trust this server" page (with QR code)
  ${B}set-ip${R} [address]            HTTPS-by-IP: update after the server's IP address changes
  ${B}drawio${R} on [port] | off       Run your own draw.io for diagrams, or go back to diagrams.net
  ${B}uninstall${R}                   Remove Synapse (asks before deleting notes)
EOF
}

# Docker needs root (or the docker group).
need_docker() {
  if ! docker info >/dev/null 2>&1; then
    if [ "$(id -u)" -ne 0 ] && command -v sudo >/dev/null 2>&1; then exec sudo -E "$0" "$@"; fi
    die "Can't reach Docker. Is it running? (sudo systemctl start docker)"
  fi
}

found=0
for f in docker-compose.yml docker-compose.yaml compose.yml compose.yaml; do
  [ -f "$SYNAPSE_DIR/$f" ] && found=1
done
# Not there? If we're standing in a Synapse folder, use that (and remember it for next time).
if [ "$found" = 0 ]; then
  for f in docker-compose.yml docker-compose.yaml compose.yml compose.yaml; do
    if [ -f "$PWD/$f" ] && grep -q 'stevy2191/synapse' "$PWD/$f"; then
      SYNAPSE_DIR="$PWD"; found=1
      self="$(realpath "$0" 2>/dev/null || echo "$0")"
      if [ -w "$self" ] && grep -q '^SYNAPSE_DIR=' "$self"; then
        sed -i "s#^SYNAPSE_DIR=.*#SYNAPSE_DIR=\"\${SYNAPSE_DIR:-$PWD}\"   \# set by the installer#" "$self" \
          && printf 'Using Synapse in %s (remembered for next time).\n' "$PWD"
      fi
      break
    fi
  done
fi
[ "$found" = 1 ] || die "No Synapse install found in $SYNAPSE_DIR. Run this from Synapse's folder (cd /path/to/synapse), or set SYNAPSE_DIR."
case "$(realpath -m "$SYNAPSE_DIR")" in
  /|/root|/home|/home/*[!/]/|/etc|/usr|/var|/opt|/srv|/mnt|/media|/tmp|/bin|/sbin|/boot) die "Refusing to manage $SYNAPSE_DIR: that's a system folder." ;;
esac
cd "$SYNAPSE_DIR"

env_get() { grep -E "^$1=" .env 2>/dev/null | tail -1 | cut -d= -f2- || true; }
# Set KEY=VALUE in .env (adding it if missing).
env_set() {
  if grep -qE "^$1=" .env 2>/dev/null; then sed -i "s|^$1=.*|$1=$2|" .env; else printf '%s=%s\n' "$1" "$2" >>.env; fi
}
compose() { docker compose "$@"; }
is_running() { compose ps --status running --services 2>/dev/null | grep -qx synapse; }
# A throwaway container with the notes mounted exactly as Synapse sees them (at /data).
with_data() { compose run --rm --no-deps -T --entrypoint sh synapse -c "$1"; }

port_in_use() {
  local p="$1"
  if command -v ss >/dev/null 2>&1; then ss -Hltn "sport = :$p" 2>/dev/null | grep -q .
  else (exec 3<>"/dev/tcp/127.0.0.1/$p") 2>/dev/null; fi
}

next_free_port() {
  local p="$1" avoid=" ${2:-} "
  while port_in_use "$p" || [[ "$avoid" == *" $p "* ]]; do p=$((p + 1)); done
  echo "$p"
}

open_firewall() {
  local p="$1"
  if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -q "Status: active"; then
    ufw status | grep -qE "^$p(/tcp)?[[:space:]]" || { ufw allow "$p/tcp" >/dev/null && ok "Firewall: port $p allowed"; }
  elif command -v firewall-cmd >/dev/null 2>&1 && firewall-cmd --state >/dev/null 2>&1; then
    firewall-cmd --list-ports | grep -qw "$p/tcp" || { firewall-cmd --permanent --add-port="$p/tcp" >/dev/null && firewall-cmd --reload >/dev/null && ok "Firewall: port $p allowed"; }
  fi
  return 0
}

# Remove the draw.io pieces from docker-compose.yml and the Caddyfile (if present).
drawio_remove_config() {
  local tmp
  tmp=$(mktemp)
  # The service block: its comment, "  drawio:" and the indented lines under it.
  awk '
    # Hold blank lines until we know whether the draw.io block follows them.
    /^[[:space:]]*$/ { if (!skip) held = held $0 "\n"; next }
    # Drop the one blank line `synapse drawio on` put before the block; keep any others.
    /^  # Your own draw.io editor/ { if (held != "") held = substr(held, 1, length(held) - 1); next }
    /^  drawio:[[:space:]]*$/ { skip = 1; next }
    skip && /^    / { next }
    { skip = 0; printf "%s", held; held = ""; print }
    END { printf "%s", held }
  ' docker-compose.yml >"$tmp" && cat "$tmp" >docker-compose.yml
  # Caddy's draw.io port mapping
  sed -i '/^      - "\${DRAWIO_PORT}:\${DRAWIO_PORT}"$/d' docker-compose.yml
  if [ -f Caddyfile ]; then
    awk '
      /^[[:space:]]*$/ && !skip { held = held $0 "\n"; next }
      # Drop the block and the one blank line added before it.
      /^# Your own draw.io, on HTTPS/ { if (held != "") held = substr(held, 1, length(held) - 1); skip = 1; next }
      skip { if (/^}/) { skip = 0 } ; next }
      { printf "%s", held; held = ""; print }
      END { printf "%s", held }
    ' Caddyfile >"$tmp" && cat "$tmp" >Caddyfile
  fi
  rm -f "$tmp"
}

lan_ip() {
  local ip
  ip=$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<NF;i++) if($i=="src"){print $(i+1); exit}}') || true
  [ -z "$ip" ] && ip=$(hostname -I 2>/dev/null | awk '{print $1}')
  echo "${ip:-localhost}"
}

address() {
  local port
  case "$(env_get SYNAPSE_MODE)" in
    https)     echo "https://$(env_get SYNAPSE_DOMAIN)"; return ;;
    lan-https) echo "https://$(env_get SYNAPSE_IP):$(env_get SYNAPSE_PORT)"; return ;;
  esac
  port=$(env_get SYNAPSE_PORT)
  # Installs set up by hand: ask Docker which port is published.
  [ -z "$port" ] && port=$(compose port synapse 3001 2>/dev/null | awk -F: 'NR==1{print $NF}')
  echo "http://$(lan_ip):${port:-3001}"
}
trust_address() { echo "http://$(env_get SYNAPSE_IP):$(env_get SYNAPSE_TRUST_PORT)"; }

storage_description() {
  local data
  data=$(env_get SYNAPSE_DATA)
  case "$(env_get SYNAPSE_STORAGE)" in
    volume) echo "Docker volume \"$data\"" ;;
    smb)    echo "network share $(compose config 2>/dev/null | awk '/device:/{gsub(/"/,"",$2); print $2; exit}')" ;;
    folder) [ "$data" = ./data ] && echo "$SYNAPSE_DIR/data" || echo "$data" ;;
    *)      echo "as set in $SYNAPSE_DIR/docker-compose.yml" ;;
  esac
}

# Same as install.sh's write_lan_caddyfile.
write_lan_caddyfile() { # IP HTTPS_PORT TRUST_PORT (draw.io port read from .env)
  cat >Caddyfile <<CADDY
# HTTPS on this server's IP address. Caddy runs a private certificate authority;
# each device trusts it once via the page on port $3. Rewritten by: synapse set-ip
{
	local_certs
	skip_install_trust
	default_sni $1
}

https://$1:$2, https://localhost:$2 {
	encode gzip
	reverse_proxy synapse:3001
}

# "Trust this server" page and certificate download (plain HTTP, so it opens without a warning)
http://:$3 {
	handle /synapse-ca.crt {
		root * /data/caddy/pki/authorities/local
		rewrite * /root.crt
		header Content-Type application/x-x509-ca-cert
		header Content-Disposition "attachment; filename=synapse-ca.crt"
		file_server
	}
	handle {
		root * /srv/trust
		file_server
	}
}
CADDY
  local dp; dp=$(env_get DRAWIO_PORT)
  if [ -n "$dp" ]; then
    printf '\n# Your own draw.io, on HTTPS with the same certificate\nhttps://%s:%s {\n\treverse_proxy drawio:8080\n}\n' "$1" "$dp" >>Caddyfile
  fi
  printf 'window.SYNAPSE = { httpsPort: %s };\n' "$2" >trust/config.js
}

show_qr() {
  if command -v qrencode >/dev/null 2>&1; then
    echo "  Scan with your phone's camera:"
    qrencode -t ANSIUTF8 -m 2 "$1" | sed 's/^/  /'
  fi
}

# backup FILE — notes (from wherever they're stored) plus this folder's settings.
make_backup() {
  local file="$1" tmp was_running=0
  tmp=$(mktemp -d)
  is_running && was_running=1
  if [ "$was_running" = 1 ]; then echo "Pausing Synapse for a moment to take a consistent copy…"; compose stop synapse >/dev/null; fi
  mkdir -p "$tmp/data"
  if ! with_data 'cd /data && tar cf - --exclude=./backups --exclude=./restore-pending --exclude=./restore-staging .' | tar xf - -C "$tmp/data"; then
    [ "$was_running" = 1 ] && compose start synapse >/dev/null
    rm -rf "$tmp"; die "Couldn't read the notes."
  fi
  [ "$was_running" = 1 ] && compose start synapse >/dev/null
  for f in .env docker-compose.yml Caddyfile; do [ -f "$f" ] && cp "$f" "$tmp/"; done
  [ -d trust ] && cp -r trust "$tmp/"
  [ -d caddy ] && cp -r caddy "$tmp/"   # includes the HTTPS-by-IP certificate authority, so devices stay trusted
  tar czf "$file" -C "$tmp" .
  rm -rf "$tmp"
}

# Automatic backups (Settings → Server → Backups) go to /backups inside the container. Older
# docker-compose.yml files don't mount it yet: add it next to the data folder's line.
ensure_backups_mount() {
  grep -q ':/backups"' docker-compose.yml && return 0
  grep -qE '^      - .*:/data"?$' docker-compose.yml || { warn "Couldn't find the data folder in docker-compose.yml — add the backups folder by hand."; return 1; }
  sed -i -E '0,/^      - .*:\/data"?$/s||&\n      - "${SYNAPSE_BACKUPS:-.\/backups}:\/backups"|' docker-compose.yml
  if ! grep -q 'SYNAPSE_BACKUPS_HOST=' docker-compose.yml; then
    sed -i '0,/^      - DATA_DIR=\/data$/s||&\n      - SYNAPSE_BACKUPS_HOST=${SYNAPSE_BACKUPS:-.\/backups}|' docker-compose.yml
  fi
  [ -n "$(env_get SYNAPSE_BACKUPS)" ] || env_set SYNAPSE_BACKUPS ./backups
  mkdir -p backups
  return 0
}

backups_description() {
  local b; b="$(env_get SYNAPSE_BACKUPS)"
  case "${b:-./backups}" in ./backups) echo "$SYNAPSE_DIR/backups" ;; *) echo "$b" ;; esac
}

# Get the newest version of this command itself (it isn't part of the Docker image).
self_update() {
  local self tmp
  self="$(realpath "$0" 2>/dev/null || echo "$0")"
  [ -w "$(dirname "$self")" ] || return 1
  tmp="$(dirname "$self")/.synapse.new.$$"
  if curl -fsSL "https://raw.githubusercontent.com/Stevy2191/synapse/main/scripts/synapse" -o "$tmp" 2>/dev/null \
      && head -1 "$tmp" | grep -q '^#!' && bash -n "$tmp" 2>/dev/null; then
    # Keep this install's folder (the installer wrote it into this copy).
    sed -i "s#^SYNAPSE_DIR=.*#SYNAPSE_DIR=\"\${SYNAPSE_DIR:-$SYNAPSE_DIR}\"   \# set by the installer#" "$tmp"
    if cmp -s "$tmp" "$self"; then rm -f "$tmp"; return 1; fi
    chmod 755 "$tmp" && mv -f "$tmp" "$self" && return 0
  fi
  rm -f "$tmp"
  return 1
}

cmd="${1:-help}"; shift || true
case "$cmd" in
  help|-h|--help) usage ;;

  status)
    need_docker "$cmd" "$@"
    if is_running; then
      ok "Synapse is running at $(address)"
    else
      warn "Synapse is not running. Start it with: synapse start  (or check: synapse logs)"
    fi
    printf '  %snotes: %s%s\n' "$D" "$(storage_description)" "$R"
    if grep -q ':/backups"' docker-compose.yml; then printf '  %sautomatic backups: %s%s\n' "$D" "$(backups_description)" "$R"; fi
    if [ -n "$(env_get DRAWIO_URL)" ]; then printf '  %sdraw.io: %s%s\n' "$D" "$(env_get DRAWIO_URL)" "$R"
    else printf '  %sdraw.io: diagrams.net%s\n' "$D" "$R"; fi
    if is_running && compose exec -T synapse test -f /data/.setup_code 2>/dev/null; then
      warn "No admin account yet — setup code: $(compose exec -T synapse cat /data/.setup_code)"
    fi
    if [ "$(env_get SYNAPSE_MODE)" = lan-https ]; then
      printf '  %sdevices trust it via %s%s\n' "$D" "$(trust_address)" "$R"
      now_ip=$(lan_ip)
      if [ "$now_ip" != "$(env_get SYNAPSE_IP)" ]; then
        warn "This server's address changed from $(env_get SYNAPSE_IP) to $now_ip. Run: synapse set-ip"
      fi
    fi
    ;;

  update)
    need_docker "$cmd" "$@"
    if [ "${1:-}" != --no-self-update ] && self_update; then
      echo "Updated the synapse command itself."
      exec "$(realpath "$0" 2>/dev/null || echo "$0")" update --no-self-update
    fi
    ensure_backups_mount || true
    echo "Downloading the latest Synapse…"
    compose pull --quiet
    compose up -d
    docker image prune -f >/dev/null 2>&1 || true
    ok "Up to date. Reload Synapse in your browser to get the new version."
    ;;

  restart) need_docker "$cmd" "$@"; compose restart; ok "Restarted" ;;
  stop)    need_docker "$cmd" "$@"; compose stop; ok "Stopped" ;;
  start)   need_docker "$cmd" "$@"; compose up -d; ok "Started at $(address)" ;;

  logs)
    need_docker "$cmd" "$@"
    svc="synapse"; follow=""
    for a in "$@"; do case "$a" in -f) follow="-f" ;; caddy) svc="caddy" ;; esac; done
    compose logs --tail 100 $follow "$svc"
    ;;

  backup)
    need_docker "$cmd" "$@"
    dest="${1:-$SYNAPSE_DIR/backups}"
    mkdir -p "$dest"
    file="$(cd "$dest" && pwd)/synapse-backup-$(date +%Y%m%d-%H%M%S).tar.gz"
    make_backup "$file"
    ok "Backup saved: $file ($(du -h "$file" | cut -f1))"
    ;;

  restore)
    need_docker "$cmd" "$@"
    file="${1:-}"
    [ -f "$file" ] || die "Usage: synapse restore <backup-file.tar.gz>"
    file="$(cd "$(dirname "$file")" && pwd)/$(basename "$file")"
    tar -tzf "$file" | grep -qE '^(\./)?data/' || die "That file doesn't look like a Synapse backup."
    warn "This replaces the current notes with the ones in $(basename "$file")."
    confirm "Continue?" || { echo "Nothing changed."; exit 0; }
    mkdir -p backups
    safety="$SYNAPSE_DIR/backups/before-restore-$(date +%Y%m%d-%H%M%S).tar.gz"
    echo "First, saving the current notes to $safety…"
    make_backup "$safety"
    tmp=$(mktemp -d)
    tar xzf "$file" -C "$tmp"
    compose stop >/dev/null
    tar cf - -C "$tmp/data" . | with_data 'find /data -mindepth 1 -delete && tar xf - -C /data'
    rm -rf "$tmp"
    compose up -d >/dev/null
    ok "Restored. If anything's wrong, the notes from before are in $safety"
    ;;

  backups-to)
    need_docker "$cmd" "$@"
    dest="${1:-}"
    [ -n "$dest" ] || die 'Usage: synapse backups-to "/mnt/nas/Synapse Backups"   (or: synapse backups-to default)'
    # Accept the path with or without quotes/backslashes, as typed or pasted.
    dest="${dest%\"}"; dest="${dest#\"}"; dest="${dest%\'}"; dest="${dest#\'}"; dest="${dest//\\ / }"
    if [ "$dest" = default ] || [ "$dest" = "./backups" ]; then
      dest=./backups; mkdir -p backups; shown="$SYNAPSE_DIR/backups"
    else
      case "$dest" in /*) ;; *) die "Use the full path, starting with / (for example /mnt/family/Synapse Backups)." ;; esac
      dest="${dest%/}"
      case "$(realpath -m "$dest")" in
        /|/root|/home|/etc|/usr|/var|/opt|/srv|/mnt|/media|/tmp|/bin|/sbin|/boot|/proc|/sys|/dev) die "Pick a folder of its own, not $dest itself." ;;
      esac
      data="$(env_get SYNAPSE_DATA)"
      if [ -n "$data" ] && [ "${data#/}" != "$data" ] && [ "$(realpath -m "$dest")" = "$(realpath -m "$data")" ]; then
        die "That's the notes folder itself — choose a different folder for backups."
      fi
      if ! mkdir -p "$dest" 2>/dev/null; then die "Couldn't create $dest. Is the share mounted? (findmnt -T \"$(dirname "$dest")\")"; fi
      probe="$dest/.synapse-write-test.$$"
      if ! ( : >"$probe" ) 2>/dev/null; then die "Can't write to $dest. Check the share's permissions (Synapse runs as root inside Docker)."; fi
      rm -f "$probe"
      shown="$dest"
      fstype="$(stat -f -c %T "$dest" 2>/dev/null || true)"
      case "$fstype" in smb*|cifs|nfs*) echo "  (That's a network share — fine for backups; they're plain files, so the nobrl setting doesn't matter here.)" ;; esac
    fi
    old="$(backups_description)"
    ensure_backups_mount || die "Couldn't update docker-compose.yml."
    env_set SYNAPSE_BACKUPS "$dest"
    compose up -d >/dev/null
    ok "Automatic backups will now be saved in: $shown"
    if [ "$old" != "$shown" ] && ls "$old"/synapse-backup-* >/dev/null 2>&1; then
      echo "  Backups made before are still in $old — move them over if you want to keep them together:"
      echo "    sudo mv \"$old\"/synapse-backup-* \"$shown/\""
    fi
    echo "  Check it any time in Synapse: Settings → Server → Backups."
    ;;

  setup-code)
    need_docker "$cmd" "$@"
    code=$(with_data 'cat /data/.setup_code 2>/dev/null' || true)
    if [ -n "$code" ]; then
      echo "Setup code: ${B}$code${R}"
      echo "Open $(address) and create the admin account with it."
    else
      ok "The admin account already exists, so no setup code is needed."
      echo "  Forgot the admin password? Run: synapse reset-password <username>"
    fi
    ;;

  users|reset-password|reset-mfa|make-admin)
    need_docker "$cmd" "$@"
    [ "$cmd" != users ] && [ -z "${1:-}" ] && die "Usage: synapse $cmd <username or email>"
    is_running || die "Synapse isn't running. Start it first: synapse start"
    compose exec -T synapse node src/cli.js "$cmd" "$@"
    ;;

  trust)
    [ "$(env_get SYNAPSE_MODE)" = lan-https ] || die "This install doesn't use HTTPS-by-IP, so there's nothing to trust."
    echo "On each phone or computer, open ${B}$(trust_address)${R} and follow the steps."
    show_qr "$(trust_address)"
    ;;

  set-ip)
    need_docker "$cmd" "$@"
    [ "$(env_get SYNAPSE_MODE)" = lan-https ] || die "Only needed for HTTPS-by-IP installs."
    new="${1:-$(lan_ip)}"
    [[ "$new" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "Usage: synapse set-ip [IPv4 address]"
    [ "$new" = "$(env_get SYNAPSE_IP)" ] && { ok "Already set to $new"; exit 0; }
    sed -i "s/^SYNAPSE_IP=.*/SYNAPSE_IP=$new/" .env
    if [ -n "$(env_get DRAWIO_PORT)" ]; then sed -i "s|^DRAWIO_URL=.*|DRAWIO_URL=https://$new:$(env_get DRAWIO_PORT)|" .env; fi
    write_lan_caddyfile "$new" "$(env_get SYNAPSE_PORT)" "$(env_get SYNAPSE_TRUST_PORT)"
    compose up -d >/dev/null   # picks up the new DRAWIO_URL too
    compose restart caddy >/dev/null
    ok "Synapse is now at $(address)"
    echo "  Devices that already trust this server don't need to do anything again."
    ;;

  port)
    need_docker "$cmd" "$@"
    new="${1:-}"
    [ "$(env_get SYNAPSE_MODE)" = https ] && die "This install uses HTTPS on ports 80/443 (through Caddy); there's no Synapse port to change."
    [ -n "$(env_get SYNAPSE_PORT)" ] || die "This install was set up by hand; change the port in $SYNAPSE_DIR/docker-compose.yml."
    [[ "$new" =~ ^[0-9]+$ ]] && [ "$new" -ge 1024 ] && [ "$new" -le 65535 ] || die "Usage: synapse port <1024-65535>"
    [ "$new" = "$(env_get SYNAPSE_PORT)" ] && { ok "Already on port $new"; exit 0; }
    port_in_use "$new" && die "Port $new is already in use. Pick another."
    [ "$new" = "$(env_get SYNAPSE_TRUST_PORT)" ] && die "Port $new is used by the certificate page."
    sed -i "s/^SYNAPSE_PORT=.*/SYNAPSE_PORT=$new/" .env
    if [ "$(env_get SYNAPSE_MODE)" = lan-https ]; then
      write_lan_caddyfile "$(env_get SYNAPSE_IP)" "$new" "$(env_get SYNAPSE_TRUST_PORT)"
    fi
    compose up -d >/dev/null
    ok "Synapse moved to $(address)"
    warn "If a firewall or reverse proxy points at the old port, update it too."
    ;;

  drawio)
    need_docker "$cmd" "$@"
    mode=$(env_get SYNAPSE_MODE)
    [ -n "$mode" ] || die "This install was set up by hand. Add the jgraph/drawio container to docker-compose.yml and set DRAWIO_URL for the synapse service."
    case "${1:-}" in
      on)
        if [ -n "$(env_get DRAWIO_URL)" ] && grep -q '^  drawio:' docker-compose.yml; then
          ok "Your own draw.io is already on: $(env_get DRAWIO_URL)"; exit 0
        fi
        drawio_remove_config   # start clean if a previous attempt was half done
        avoid="$(env_get SYNAPSE_PORT) $(env_get SYNAPSE_TRUST_PORT)"
        case "$mode" in home|proxy) start=8081 ;; *) start=8444 ;; esac
        dp="${2:-$(next_free_port "$start" "$avoid")}"
        [[ "$dp" =~ ^[0-9]+$ ]] && [ "$dp" -ge 1024 ] && [ "$dp" -le 65535 ] || die "Usage: synapse drawio on [port]"
        port_in_use "$dp" && die "Port $dp is already in use. Pick another: synapse drawio on <port>"
        [[ " $avoid " == *" $dp "* ]] && die "Port $dp is already used by Synapse. Pick another."
        case "$mode" in
          home)      url="http://$(lan_ip):$dp" ;;
          proxy)     url="http://$(lan_ip):$dp" ;;
          https)     url="https://$(env_get SYNAPSE_DOMAIN):$dp" ;;
          lan-https) url="https://$(env_get SYNAPSE_IP):$dp" ;;
          *) die "Unknown setup mode: $mode" ;;
        esac
        if [ "$mode" = proxy ] && [ -r /dev/tty ]; then
          echo "Browsers block plain-http pages inside an https site, so give draw.io its own proxy host"
          echo "(forward it to $(lan_ip):$dp), e.g. https://drawio.example.com"
          printf 'Address people will use for draw.io %s[%s]%s ' "$D" "$url" "$R"
          IFS= read -r answer </dev/tty || answer=""
          url="${answer:-$url}"; url="${url%/}"
        fi
        env_set DRAWIO_PORT "$dp"
        env_set DRAWIO_URL "$url"
        # Older installs: make sure Synapse is handed DRAWIO_URL.
        if ! grep -q 'DRAWIO_URL=\${DRAWIO_URL' docker-compose.yml; then
          sed -i '0,/^      - DATA_DIR=\/data$/s||      - DATA_DIR=/data\n      - DRAWIO_URL=${DRAWIO_URL:-}|' docker-compose.yml
        fi
        # The draw.io service goes at the end of the services list (before a top-level volumes: section).
        block=$(printf '\n  # Your own draw.io editor (diagrams are still saved in Synapse)\n  drawio:\n    image: jgraph/drawio:latest\n    container_name: ${SYNAPSE_CONTAINER:-synapse}-drawio\n    restart: unless-stopped\n')
        case "$mode" in home|proxy) block+=$(printf '\n    ports:\n      - "${DRAWIO_PORT}:8080"') ;; esac
        tmp=$(mktemp)
        BLOCK="$block" awk 'BEGIN { b = ENVIRON["BLOCK"] } /^volumes:/ && !done { print b; print ""; done = 1 } { print } END { if (!done) print b }' docker-compose.yml >"$tmp" && cat "$tmp" >docker-compose.yml
        rm -f "$tmp"
        case "$mode" in
          https)
            sed -i 's|^      - "443:443/udp"$|      - "443:443/udp"\n      - "${DRAWIO_PORT}:${DRAWIO_PORT}"|' docker-compose.yml
            printf '\n# Your own draw.io, on HTTPS with the same certificate\n%s:%s {\n\treverse_proxy drawio:8080\n}\n' "$(env_get SYNAPSE_DOMAIN)" "$dp" >>Caddyfile ;;
          lan-https)
            sed -i 's|^      - "${SYNAPSE_TRUST_PORT}:${SYNAPSE_TRUST_PORT}"$|      - "${SYNAPSE_TRUST_PORT}:${SYNAPSE_TRUST_PORT}"\n      - "${DRAWIO_PORT}:${DRAWIO_PORT}"|' docker-compose.yml
            write_lan_caddyfile "$(env_get SYNAPSE_IP)" "$(env_get SYNAPSE_PORT)" "$(env_get SYNAPSE_TRUST_PORT)" ;;
        esac
        compose config -q || die "The updated docker-compose.yml isn't valid. Nothing was started; please report this."
        open_firewall "$dp"
        echo "Downloading and starting draw.io (a large download the first time)…"
        compose up -d
        ok "Your own draw.io is on: $url"
        [ "$mode" = proxy ] && warn "Remember to add a proxy host for $url → $(lan_ip):$dp"
        echo "  Reload Synapse in your browser to start using it."
        ;;
      off)
        drawio_remove_config
        env_set DRAWIO_PORT ""
        env_set DRAWIO_URL ""
        if [ "$mode" = lan-https ]; then
          write_lan_caddyfile "$(env_get SYNAPSE_IP)" "$(env_get SYNAPSE_PORT)" "$(env_get SYNAPSE_TRUST_PORT)"
        fi
        compose config -q || die "The updated docker-compose.yml isn't valid; please report this."
        compose up -d --remove-orphans
        ok "Diagrams now use diagrams.net again. Reload Synapse in your browser."
        ;;
      *) die "Usage: synapse drawio on [port]  |  synapse drawio off" ;;
    esac
    ;;

  uninstall)
    need_docker "$cmd" "$@"
    warn "This stops and removes Synapse."
    confirm "Continue?" || { echo "Nothing changed."; exit 0; }
    where="$(storage_description)"
    bk=""; case "$(env_get SYNAPSE_BACKUPS)" in ""|./backups) bk=" and the backups in $SYNAPSE_DIR/backups" ;; esac
    if confirm "Also DELETE all notes and uploads ($where)$bk? This cannot be undone."; then
      with_data 'find /data -mindepth 1 -delete' || warn "Couldn't delete everything in $where."
      compose down -v --remove-orphans
      cd / && rm -rf "$SYNAPSE_DIR"
      ok "Synapse and its notes were removed."
    else
      compose down --remove-orphans
      ok "Synapse was removed. Your notes are still in $where — run the installer in $SYNAPSE_DIR to bring it back."
    fi
    rm -f "$0" 2>/dev/null || true
    ;;

  *) echo "Unknown command: $cmd"; echo; usage; exit 1 ;;
esac
